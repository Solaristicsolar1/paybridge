# ==================================================
# PAYBRIDGE - ENVIRONMENT CONFIGURATION
# ==================================================
# Copy this file to .env and replace placeholder values.
# Never commit the actual .env file.
# ==================================================


# --------------------------------------------------
# 1. APPLICATION ENVIRONMENT
# --------------------------------------------------

NODE_ENV=development

API_PORT=4000

API_PUBLIC_URL=http://localhost:4000

WEB_ORIGIN=http://localhost:3000


# --------------------------------------------------
# 2. FRONTEND CONFIGURATION
# --------------------------------------------------

# Public API endpoint consumed by the Next.js frontend.
NEXT_PUBLIC_API_URL=http://localhost:4000/v1


# --------------------------------------------------
# 3. POSTGRESQL DATABASE
# --------------------------------------------------

POSTGRES_USER=paybridge
POSTGRES_PASSWORD=change_me
POSTGRES_DB=paybridge
POSTGRES_PORT=5433

DATABASE_URL=postgresql://paybridge:change_me@localhost:5433/paybridge?schema=public


# --------------------------------------------------
# 4. AUTHENTICATION AND SECURITY
# --------------------------------------------------

# Generate unique, secure secrets for each environment.
JWT_ACCESS_SECRET=replace_with_secure_access_secret
JWT_REFRESH_SECRET=replace_with_secure_refresh_secret

JWT_REFRESH_EXPIRES_IN_DAYS=30


# --------------------------------------------------
# 5. EMAIL / SMTP CONFIGURATION
# --------------------------------------------------

SMTP_HOST=smtp.example.com
SMTP_PORT=587
SMTP_SECURE=false

SMTP_USER=your_email@example.com
SMTP_PASS=replace_with_smtp_password

SMTP_FROM=PayBridge <no-reply@example.com>


# --------------------------------------------------
# 6. EMAIL VERIFICATION
# --------------------------------------------------

EMAIL_VERIFICATION_EXPIRES_IN_MINUTES=1440

EMAIL_VERIFICATION_RESEND_COOLDOWN_SECONDS=60


# --------------------------------------------------
# 7. PASSWORD RESET
# --------------------------------------------------

PASSWORD_RESET_EXPIRES_IN_MINUTES=30

PASSWORD_RESET_COOLDOWN_SECONDS=60


# --------------------------------------------------
# 8. NEAR INTENTS - 1CLICK API
# --------------------------------------------------

NEAR_INTENTS_API_URL=https://1click.chaindefuser.com

# Obtain your own partner API key.
# Never expose this key to the frontend.
NEAR_INTENTS_API_KEY=your_near_intents_api_key
