
generator client {
  provider     = "prisma-client"
  output       = "../src/generated/prisma"
  moduleFormat = "cjs"
}

datasource db {
  provider = "postgresql"
}

// ==========================================
// ENUMS
// ==========================================

enum BusinessRole {
  OWNER
  ADMIN
  ACCOUNTANT
  MEMBER
}

enum MembershipStatus {
  ACTIVE
  INVITED
  SUSPENDED
}

enum BusinessInvitationStatus {
  PENDING
  ACCEPTED
  REVOKED
}

enum InvoiceStatus {
  DRAFT
  SENT
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

enum PaymentStatus {
  PENDING
  CONFIRMED
  FAILED
  REFUNDED
  EXPIRED
}

enum InstallmentStatus {
  SCHEDULED
  DUE
  PARTIALLY_PAID
  PAID
  OVERDUE
  CANCELLED
}

// ==========================================
// USER
// ==========================================

model User {
  id              String    @id @default(uuid()) @db.Uuid
  email           String    @unique @db.VarChar(320)
  passwordHash    String?
  displayName     String?   @db.VarChar(120)
  emailVerifiedAt DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  memberships             BusinessMember[]
  sentBusinessInvitations BusinessInvitation[] @relation("BusinessInvitationSender")
  createdBusinesses       Business[] @relation("BusinessCreator")
  createdInvoices         Invoice[] @relation("InvoiceCreator")
  sessions                AuthSession[]
}

// ==========================================
// BUSINESS
// ==========================================

model Business {
  id              String   @id @default(uuid()) @db.Uuid
  name            String   @db.VarChar(160)
  slug            String   @unique @db.VarChar(80)
  defaultCurrency String   @default("USD") @db.Char(3)
  createdById     String   @db.Uuid
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  createdBy User @relation(
    "BusinessCreator",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  members      BusinessMember[]
  invitations  BusinessInvitation[]
  clients      Client[]
  invoices     Invoice[]

  @@index([createdById])
}

// ==========================================
// BUSINESS MEMBERS
// ==========================================

model BusinessMember {
  id         String           @id @default(uuid()) @db.Uuid
  businessId String           @db.Uuid
  userId     String           @db.Uuid
  role       BusinessRole     @default(MEMBER)
  status     MembershipStatus @default(ACTIVE)

  // Legacy invitation fields.
  // Retained temporarily for backward compatibility.
  invitedAt             DateTime?
  joinedAt              DateTime?
  invitationTokenHash   String?   @unique @db.VarChar(64)
  invitationExpiresAt   DateTime?

  createdAt DateTime @default(now())

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Cascade
  )

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@unique([businessId, userId])
  @@index([userId])
  @@index([businessId, role])
  @@index([invitationExpiresAt])
}

// ==========================================
// BUSINESS INVITATIONS
// ==========================================

model BusinessInvitation {
  id         String                   @id @default(uuid()) @db.Uuid
  businessId String                   @db.Uuid
  email      String                   @db.VarChar(320)
  role       BusinessRole             @default(MEMBER)
  status     BusinessInvitationStatus @default(PENDING)

  // SHA-256 hash of the raw invitation token.
  // Never store the raw token in the database.
  tokenHash String? @unique @db.VarChar(64)

  // Invitation lifecycle.
  expiresAt  DateTime
  acceptedAt DateTime?
  revokedAt  DateTime?

  // User who sent the invitation.
  invitedById String? @db.Uuid

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Cascade
  )

  invitedBy User? @relation(
    "BusinessInvitationSender",
    fields: [invitedById],
    references: [id],
    onDelete: SetNull
  )

  // Intentionally no unique constraint on businessId + email.
  // PostgreSQL partial unique index will enforce one pending
  // invitation per business and email while preserving history.

  @@index([businessId, email, status])
  @@index([email, status])
  @@index([businessId, status])
  @@index([expiresAt, status])
}

// ==========================================
// CLIENTS
// ==========================================

model Client {
  id             String   @id @default(uuid()) @db.Uuid
  businessId     String   @db.Uuid
  name           String   @db.VarChar(160)
  email          String?  @db.VarChar(320)
  phone          String?  @db.VarChar(30)
  companyName    String?  @db.VarChar(160)
  billingAddress String?
  notes          String?
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Restrict
  )

  invoices Invoice[]

  @@unique([id, businessId])
  @@index([businessId])
  @@index([businessId, email])
}

// ==========================================
// INVOICES
// ==========================================

model Invoice {
  id            String        @id @default(uuid()) @db.Uuid
  businessId    String        @db.Uuid
  clientId      String        @db.Uuid
  createdById   String        @db.Uuid
  invoiceNumber String        @db.VarChar(50)
  publicToken   String        @unique @default(uuid()) @db.Uuid
  status        InvoiceStatus @default(DRAFT)
  currency      String        @default("USD") @db.Char(3)
  issueDate     DateTime      @default(now())
  dueDate       DateTime?
  subtotal      Decimal       @db.Decimal(20, 8)
  taxAmount     Decimal       @default(0) @db.Decimal(20, 8)
  totalAmount   Decimal       @db.Decimal(20, 8)
  notes         String?
  createdAt     DateTime      @default(now())
  updatedAt     DateTime      @updatedAt

  business Business @relation(
    fields: [businessId],
    references: [id],
    onDelete: Restrict
  )

  client Client @relation(
    fields: [clientId, businessId],
    references: [id, businessId],
    onDelete: Restrict
  )

  createdBy User @relation(
    "InvoiceCreator",
    fields: [createdById],
    references: [id],
    onDelete: Restrict
  )

  items        InvoiceItem[]
  installments Installment[]
  payments     Payment[]

  @@unique([businessId, invoiceNumber])
  @@index([businessId, status])
  @@index([clientId])
  @@index([dueDate])
}

// ==========================================
// INVOICE ITEMS
// ==========================================

model InvoiceItem {
  id          String   @id @default(uuid()) @db.Uuid
  invoiceId   String   @db.Uuid
  description String   @db.VarChar(500)
  quantity    Decimal  @db.Decimal(20, 8)
  unitPrice   Decimal  @db.Decimal(20, 8)
  lineTotal   Decimal  @db.Decimal(20, 8)
  position    Int      @default(0)
  createdAt   DateTime @default(now())

  invoice Invoice @relation(
    fields: [invoiceId],
    references: [id],
    onDelete: Cascade
  )

  @@index([invoiceId, position])
}

// ==========================================
// INSTALLMENTS
// ==========================================

model Installment {
  id                String            @id @default(uuid()) @db.Uuid
  invoiceId         String            @db.Uuid
  installmentNumber Int
  amount            Decimal           @db.Decimal(20, 8)
  dueDate           DateTime
  status            InstallmentStatus @default(SCHEDULED)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt

  invoice Invoice @relation(
    fields: [invoiceId],
    references: [id],
    onDelete: Restrict
  )

  payments Payment[]

  @@unique([id, invoiceId])
  @@unique([invoiceId, installmentNumber])
  @@index([invoiceId, status])
  @@index([dueDate, status])
}

// ==========================================
// PAYMENTS
// ==========================================

model Payment {
  id            String  @id @default(uuid()) @db.Uuid
  invoiceId     String  @db.Uuid
  installmentId String? @db.Uuid

  status            PaymentStatus @default(PENDING)
  provider          String        @default("near-intents-1click")
  providerReference String?       @unique
  idempotencyKey    String?       @unique @db.VarChar(128)

  // Amount credited towards the invoice.
  invoiceAmount Decimal @db.Decimal(20, 8)

  // Original asset supplied by the payer.
  sourceChain        String?  @db.VarChar(60)
  sourceTokenAddress String?
  sourceTokenSymbol  String?  @db.VarChar(30)
  sourceAmount       Decimal? @db.Decimal(36, 18)
  sourceTxHash       String?

  // Settlement destination.
  destinationChain       String   @default("near") @db.VarChar(60)
  destinationTokenSymbol String   @default("USDC") @db.VarChar(30)
  destinationAmount      Decimal? @db.Decimal(36, 18)
  destinationTxHash      String?

  depositAddress String?
  expiresAt      DateTime?
  confirmedAt    DateTime?
  refundedAt     DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  invoice Invoice @relation(
    fields: [invoiceId],
    references: [id],
    onDelete: Restrict
  )

  installment Installment? @relation(
    fields: [installmentId, invoiceId],
    references: [id, invoiceId],
    onDelete: Restrict
  )

  events PaymentEvent[]

  @@unique([sourceChain, sourceTxHash])
  @@unique([destinationChain, destinationTxHash])
  @@index([invoiceId, status])
  @@index([installmentId])
  @@index([providerReference])
}

// ==========================================
// PAYMENT EVENTS
// ==========================================

model PaymentEvent {
  id             String         @id @default(uuid()) @db.Uuid
  paymentId      String         @db.Uuid
  eventType      String         @db.VarChar(80)
  previousStatus PaymentStatus?
  newStatus      PaymentStatus?
  reference      String?
  metadata       Json?
  occurredAt     DateTime       @default(now())

  payment Payment @relation(
    fields: [paymentId],
    references: [id],
    onDelete: Restrict
  )

  @@index([paymentId, occurredAt])
}

// ==========================================
// AUTHENTICATION SESSIONS
// ==========================================

model AuthSession {
  id     String @id @default(uuid()) @db.Uuid
  userId String @db.Uuid

  // SHA-256 hash of the refresh token secret.
  tokenHash String @unique @db.VarChar(64)

  expiresAt  DateTime
  revokedAt  DateTime?
  lastUsedAt DateTime?

  userAgent String? @db.VarChar(500)
  ipAddress String? @db.VarChar(64)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  user User @relation(
    fields: [userId],
    references: [id],
    onDelete: Cascade
  )

  @@index([userId, revokedAt])
  @@index([expiresAt])
}
